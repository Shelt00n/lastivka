# All variables are optional for local development.

# PostgreSQL connection string. Required in production.
# Without it, local dev uses PGlite (embedded PostgreSQL) stored in $DATA_DIR/pglite.
# DATABASE_URL=postgres://user:password@host:5432/lastivka

# Production: port the server listens on (Render/Fly set it).
PORT=8080
# Dev: port of the API behind Vite's /api proxy (`npm run dev`).
API_PORT=3001

# Folder for the local embedded database.
DATA_DIR=data

# Password for the seeded shared demo accounts `demo` and `demo2`.
DEMO_PASSWORD=lastivka-demo

# Secure cookies (`__Host-` prefix + Secure). Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=true

# Behind a reverse proxy (Render, Fly, nginx): read the client IP from proxy headers for rate limiting.
TRUST_PROXY=false

# Optional extra allowed Origin for state-changing requests, e.g. https://lastivka.example.com
# PUBLIC_ORIGIN=
